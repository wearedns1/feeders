# Source
CTU2RPZ_SOURCE=https://ctu.gov.cz/vyhledavaci-databaze/blokovane-weby/csv
CTU2RPZ_OUTPUT=./ctu.zone

# Zone
CTU2RPZ_ZONE_NAME=rpz.example.
# CTU2RPZ_TTL=300
# CTU2RPZ_HEADER_COMMENT=Generated by ctu2rpz from a CSV feed

# SOA
# CTU2RPZ_SOA_REFRESH=300
# CTU2RPZ_SOA_RETRY=60
# CTU2RPZ_SOA_EXPIRE=604800
# CTU2RPZ_SOA_MINIMUM=300

# RPZ policy
# CTU2RPZ_SINKHOLE=CNAME .
# CTU2RPZ_ADD_WILDCARD=false

# HTTP
# CTU2RPZ_TIMEOUT=30
# CTU2RPZ_MAX_REDIRECTS=3
# CTU2RPZ_USER_AGENT=ctu2rpz/1.0
# CTU2RPZ_USE_ETAG=true
# Optional request headers, suffix maps `_` to `-`
# CTU2RPZ_HTTP_HEADER_AUTHORIZATION='Bearer example-token'
# CTU2RPZ_HTTP_HEADER_AUTHORIZATION='Basic base64(username:password)'

# Logging
# CTU2RPZ_LOG_LEVEL=info
# CTU2RPZ_LOG_TIMESTAMP=true

# Actions
# CTU2RPZ_ACTION_SUCCESS='echo "Success with $FEEDER_NAME $FEEDER_EVENT $FEEDER_OUTPUT"'
# CTU2RPZ_ACTION_NOT_MODIFIED='echo "Source unchanged: $FEEDER_SOURCE"'
# CTU2RPZ_ACTION_FAILURE='echo "Failure with $FEEDER_NAME $FEEDER_EVENT $FEEDER_SOURCE"'
