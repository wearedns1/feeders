# Source
HOSTS2RPZ_SOURCE=https://example.invalid/source.hosts
HOSTS2RPZ_OUTPUT=./adult.zone

# Zone
HOSTS2RPZ_ZONE_NAME=rpz.example.
# HOSTS2RPZ_TTL=300
# HOSTS2RPZ_HEADER_COMMENT=Generated by hosts2rpz from a hosts feed

# SOA
# HOSTS2RPZ_SOA_REFRESH=300
# HOSTS2RPZ_SOA_RETRY=60
# HOSTS2RPZ_SOA_EXPIRE=604800
# HOSTS2RPZ_SOA_MINIMUM=300

# RPZ policy
# HOSTS2RPZ_SINKHOLE=CNAME .
# HOSTS2RPZ_ADD_WILDCARD=false

# HTTP
# HOSTS2RPZ_TIMEOUT=30
# HOSTS2RPZ_MAX_REDIRECTS=3
# HOSTS2RPZ_USER_AGENT=hosts2rpz/1.0
# HOSTS2RPZ_USE_ETAG=true
# Optional request headers, suffix maps `_` to `-`
# HOSTS2RPZ_HTTP_HEADER_AUTHORIZATION='Bearer example-token'
# HOSTS2RPZ_HTTP_HEADER_AUTHORIZATION='Basic base64(username:password)'

# Logging
# HOSTS2RPZ_LOG_LEVEL=info
# HOSTS2RPZ_LOG_TIMESTAMP=true

# Actions
# HOSTS2RPZ_ACTION_SUCCESS='echo "Success with $FEEDER_NAME $FEEDER_EVENT $FEEDER_OUTPUT"'
# HOSTS2RPZ_ACTION_NOT_MODIFIED='echo "Source unchanged: $FEEDER_SOURCE"'
# HOSTS2RPZ_ACTION_FAILURE='echo "Failure with $FEEDER_NAME $FEEDER_EVENT $FEEDER_SOURCE"'
