# Source
RPZ2RPZ_SOURCE=https://example.invalid/source.rpz
RPZ2RPZ_OUTPUT=./example.zone

# Zone
# RPZ2RPZ_ZONE_NAME=rpz.example.
# RPZ2RPZ_TTL=300
# RPZ2RPZ_HEADER_COMMENT=Generated by rpz2rpz from an RPZ feed

# SOA
# RPZ2RPZ_SOA_REFRESH=300
# RPZ2RPZ_SOA_RETRY=60
# RPZ2RPZ_SOA_EXPIRE=604800
# RPZ2RPZ_SOA_MINIMUM=300

# RPZ policy
# Leave RPZ2RPZ_SINKHOLE unset to preserve source policies.
# Set it to rewrite every source policy owner, for example:
# RPZ2RPZ_SINKHOLE=CNAME .
# RPZ2RPZ_ADD_WILDCARD=false

# HTTP
# RPZ2RPZ_TIMEOUT=30
# RPZ2RPZ_MAX_REDIRECTS=3
# RPZ2RPZ_USER_AGENT=rpz2rpz/1.0
# RPZ2RPZ_USE_ETAG=true
# Optional request headers, suffix maps `_` to `-`
# RPZ2RPZ_HTTP_HEADER_AUTHORIZATION='Bearer example-token'
# RPZ2RPZ_HTTP_HEADER_AUTHORIZATION='Basic base64(username:password)'

# Logging
# RPZ2RPZ_LOG_LEVEL=info
# RPZ2RPZ_LOG_TIMESTAMP=true

# Actions
# RPZ2RPZ_ACTION_SUCCESS='echo "Success with $FEEDER_NAME $FEEDER_EVENT $FEEDER_OUTPUT"'
# RPZ2RPZ_ACTION_NOT_MODIFIED='echo "Source unchanged: $FEEDER_SOURCE"'
# RPZ2RPZ_ACTION_FAILURE='echo "Failure with $FEEDER_NAME $FEEDER_EVENT $FEEDER_SOURCE"'
